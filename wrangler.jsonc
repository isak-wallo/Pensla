// Skarpa versionen på pensla.keiws.com (Cloudflare Workers med statiska
// filer), och testversionen med galleriet på test.pensla.keiws.com (env
// test). Publiceras bara med verktyg/slapp.py, som bygger webb/ med appens
// filer (ASSETS i sw.js) från den pushade koden.
//
// worker/mottagare.js tar emot de hemliga markeringarna (POST
// /api/markering) och körs bara för /api/* (run_worker_first) och för
// adresser som inte är en fil; då skickar den vidare till filerna, så att
// allt annat serveras som utan worker. Workern tas från arbetskopian (inte
// från origin/main som webb/).
//
// Databasen (D1) där markeringarna sparas är kopplad sedan 2026-11-23
// (pensla-markeringar, en databas för skarpt och test; se CLAUDE.md,
// "Hemlig markering"). Utan bindningen svarar mottagaren "stangd" och appen
// behåller markeringarna i sin kö.
{
  "name": "pensla",
  "compatibility_date": "2026-10-01",
  "main": "worker/mottagare.js",
  "assets": { "directory": "./webb", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "pensla-markeringar", "database_id": "e5f563fa-635a-4419-9a88-66c7defe2e3b" }
  ],
  "routes": [
    { "pattern": "pensla.keiws.com", "custom_domain": true }
  ],
  "env": {
    "test": {
      // Ingen omdirigering av index.html och galleri.html: Pensla test har
      // scope ./index.html och galleriet ./galleri (se slapp.py). Adressen /
      // ger ändå appen (single-page-application).
      "assets": { "directory": "./webb", "binding": "ASSETS", "run_worker_first": ["/api/*"],
                  "html_handling": "none",
                  "not_found_handling": "single-page-application" },
      // Samma databas som den skarpa (kolumnen miljo skiljer dem åt).
      "d1_databases": [
        { "binding": "DB", "database_name": "pensla-markeringar", "database_id": "e5f563fa-635a-4419-9a88-66c7defe2e3b" }
      ],
      "routes": [
        { "pattern": "test.pensla.keiws.com", "custom_domain": true }
      ]
    }
  }
}
